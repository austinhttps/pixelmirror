<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/privacyOverlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overlay_black_oled"
    android:keepScreenOn="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:id="@+id/ivPrivacyShield"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_visibility_off"
            app:tint="#80FFFFFF"
            android:contentDescription="@string/overlay_privacy_message" />

        <TextView
            android:id="@+id/tvPrivacyMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/overlay_privacy_message"
            android:textColor="#B3FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPrivacySub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/overlay_privacy_sub"
            android:textColor="#66FFFFFF"
            android:textSize="13sp" />

    </LinearLayout>

</FrameLayout>
